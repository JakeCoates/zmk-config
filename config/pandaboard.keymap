#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/ext_power.h>
&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    /* input config for mouse move mode */
    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <0 2 7>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <3>;
        bindings = <&ib_toggle_layer 7>;
    };

    /* input config for snipe mode */
    trackball_snipe_listener {
        compatible = "zmk,input-behavior-listener";   
        device = <&vtrackball>;
        layers = <8>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <4>;
    };

    /* input config for mouse scroll mode */
    trackball_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <9>;
        evt-type = <INPUT_EV_REL>;            
        x-input-code = <INPUT_REL_MISC>;
        y-input-code = <INPUT_REL_WHEEL>;
        y-invert;
        bindings = <&ib_wheel_scaler 1 16>;
    };

    /* define a resolution down scaler only for INPUT_REL_WHEEL */
    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };

    /* adjust cooldown waiting period for mouse key layer after activated */
    ib_toggle_layer: ib_toggle_layer {
        compatible = "zmk,input-behavior-tog-layer";
        #binding-cells = <1>;
        time-to-live-ms = <750>;
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";

            // -----------------------------------------------------------------------------------------
            // |  Escape |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7  |  F8 |  F9 | F10 |  +   |
            // |  `   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8  |  9  |  0  |  -   |
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
            //                          | LWR |               | RSE  |

            bindings = <
&kp ESCAPE       &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                 &kp F6          &kp F7        &kp F8        &kp F9        &kp F10       &kp ESC
&kp GRAVE        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                 &kp NUMBER_6    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp BACKSPACE
&mt LA(TAB) TAB  &kp Q         &kp W         &kp E         &kp R         &kp T                  &kp Y           &kp U         &kp I         &kp O         &kp P         &kp BSPC
&kp LEFT_SHIFT   &kp A         &kp S         &kp D         &kp F         &kp G                  &kp H           &kp J         &kp K         &kp L         &kp SEMI      &mt RIGHT_SHIFT RIGHT_PARENTHESIS
&kp LCTRL        &kp Z         &kp X         &kp C         &kp V         &kp B                  &kp N           &kp M         &kp COMMA     &kp DOT       &kp FSLH      &mt RCTRL ESC
                               &kp SPACE     &mo 1         &kp LEFT_ALT  &kp LEFT_WIN           &kp DEL         &kp LEFT_SHIFT &mo 2        &kp ENTER       &kp NUMBER_4  &kp NUMBER_5
            >;
        };

        Lower {
            label = "Lower";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI |     | SPC |   | ENT |     | ALT |
            //                          | LWR |               | RSE  |

            bindings = <
&tog 3      &kp LANG4     &kp LEFT      &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT             &kp LEFT_ARROW  &kp UP_ARROW       &kp DOWN   &kp RIGHT  &kp RIGHT_BRACE  &kp PLUS
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4          &kp LEFT        &kp UP_ARROW       &kp DOWN   &kp RIGHT  &trans           &kp PRINTSCREEN
&trans      &trans        &trans        &kp UP_ARROW  &trans          &trans                &trans          &trans             &trans     &trans     &trans           &kp DELETE
&trans      &kp LG(A)     &kp LEFT      &kp DOWN      &kp RIGHT       &trans                &kp GRAVE       &kp DOUBLE_QUOTES  &kp SQT    &trans     &kp SEMI         &kp SQT
&trans      &kp LG(Z)     &kp LG(X)     &kp LG(C)     &kp LG(V)       &kp LEFT_WIN          &kp CARET       &kp TILDE          &kp COMMA  &kp DOT    &kp FSLH         &kp ESC
&trans        &trans        &trans        &trans        &trans          &trans              &trans  &trans          &trans             &trans     &trans        &trans        
            >;
        };

        Raise {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |
            //                          | LWR |               | RSE  |

            bindings = <
&kp TAB    &kp LEFT_BRACE  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT          &kp LEFT   &kp UP_ARROW  &kp DOWN          &kp RIGHT             &kp RPAR               &kp EQUAL
&kp LCTRL  &trans          &kp AT_SIGN     &trans        &trans          &trans             &kp MINUS  &kp EQUAL     &kp EQUAL         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&trans     &trans          &trans          &kp UP_ARROW  &trans          &trans             &kp UNDER  &kp PLUS      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp AT                 &kp TILDE
&trans     &trans          &kp LEFT        &kp DOWN      &kp RIGHT       &trans             &kp UNDER  &kp PLUS      &kp LBRC          &kp RBRC              &kp NON_US_HASH        &kp TILDE
&trans     &kp BACKSLASH   &trans          &trans        &trans          &trans             &kp UNDER  &kp PLUS      &kp LBRC          &kp RBRC              &kp NON_US_BSLH        &kp PIPE
                           &trans          &trans        &trans          &trans     &trans  &trans     &trans        &trans
            >;
        };

        Hiragana {
            label = "Hiragana";
            bindings = <
&trans     &kp LBKT  &trans  &trans  &trans  &trans          &trans  &trans  &trans     &trans   &kp RBKT  &kp EQUAL
&kp GRAVE  &kp N1    &kp N2  &kp N3  &kp N4  &kp N5          &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp APOS   &kp Q     &kp W   &kp E   &kp R   &kp T           &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSPC
&kp LSHFT  &kp A     &kp S   &kp D   &kp F   &kp G           &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp APOS
&kp LCTRL  &kp Z     &kp X   &kp C   &kp V   &kp B           &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RCTRL
                     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        
        MOUSE {
            bindings = <
&none    &msc MOVE_LEFT  &msc MOVE_UP    &mmv MOVE_UP    &msc MOVE_DOWN   &msc MOVE_RIGHT    &none  &none            &none      &none         &none          &none
&kp TAB  &mkp MB4        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB5           &none  &kp RIGHT_SHIFT  &kp RCTRL  &kp LEFT_ALT  &kp LEFT_META  &none
&none    &kp C_AC_UNDO   &kp C_AC_CUT    &kp C_AC_COPY   &kp C_AC_PASTE   &mkp MCLK          &none  &none            &none      &none         &none          &none
                                         &tdtb2          &mkp LCLK        &mkp RCLK          &kp RETURN              &lt 3 SPACE
            >;
        };

        SLOW {
            bindings = <
&none    &msc MOVE_LEFT  &msc MOVE_UP    &mmv MOVE_UP    &msc MOVE_DOWN   &msc MOVE_RIGHT    &none  &none            &none      &none         &none          &none
&kp TAB  &mkp MB4        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB5           &none  &kp RIGHT_SHIFT  &kp RCTRL  &kp LEFT_ALT  &kp LEFT_META  &none
&none    &kp C_AC_UNDO   &kp C_AC_CUT    &kp C_AC_COPY   &kp C_AC_PASTE   &mkp MCLK          &none  &none            &none      &none         &none          &none
                                         &tdtb2          &mkp LCLK        &mkp RCLK          &kp RETURN              &lt 3 SPACE
            >;
        };

        SCROLL {
            bindings = <
&none    &msc MOVE_LEFT  &msc MOVE_UP    &mmv MOVE_UP    &msc MOVE_DOWN   &msc MOVE_RIGHT    &none  &none            &none      &none         &none          &none
&kp TAB  &mkp MB4        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB5           &none  &kp RIGHT_SHIFT  &kp RCTRL  &kp LEFT_ALT  &kp LEFT_META  &none
&none    &kp C_AC_UNDO   &kp C_AC_CUT    &kp C_AC_COPY   &kp C_AC_PASTE   &mkp MCLK          &none  &none            &none      &none         &none          &none
                                         &tdtb2          &mkp LCLK        &mkp RCLK          &kp RETURN              &lt 3 SPACE
            >;
        };
    };
};
