#include <behaviors/mouse_keys.dtsi>
#include <behaviors/mouse_key_press.dtsi>
#include <behaviors/mouse_key_toggle.dtsi>
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors/report_rate_limit.dtsi>
#include <input/processors/xyz.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// index of keymap layers

#define DEF 0 // default layer
#define MSK 6 // mouse key layer
#define MSC 7 // mouse scoll layer

/ {
    behaviors {
        m_v: mouse_move {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            trigger-period-ms = <12>; // slow down for OTA, default is 3ms
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            time-to-max-speed-ms = <300>;
            acceleration-exponent = <1>;
        };

        m_s: mouse_scroll {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            trigger-period-ms = <12>; // slow down for OTA, default is 3ms
            x-input-code = <INPUT_REL_HWHEEL>;
            y-input-code = <INPUT_REL_WHEEL>;
            time-to-max-speed-ms = <50>;
            acceleration-exponent = <1>;
        };
    };

    mmv_input_listener {
        compatible = "zmk,input-listener";
        device = <&m_v>;
    };

    mms_input_listener {
        compatible = "zmk,input-listener";
        device = <&m_s>;
    };

    macros {
        pickup_hop: pickup_hop {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp LCLK &none &kp LC(E)>;
            label = "PICKUP_HOP";
            wait-ms = <700>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";

            // -----------------------------------------------------------------------------------------
            // |  Escape |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7  |  F8 |  F9 | F10 |  +   |
            // |  `   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8  |  9  |  0  |  -   |
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
            //                          | LWR |               | RSE  |

            bindings = <
&kp ESCAPE       &kp F1        &kp F2        &kp F3        &kp F4        &kp F5            &kp F6          &kp F7        &kp F8        &kp F9        &kp F10       &kp ESC
&kp GRAVE        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5            &kp NUMBER_6    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp BACKSPACE
&mt LA(TAB) TAB  &kp Q         &kp W         &kp E         &kp R         &kp T             &kp Y           &kp U         &kp I         &kp O         &kp P         &kp BSPC
&kp LEFT_SHIFT   &kp A         &kp S         &kp D         &kp F         &kp G             &kp H           &kp J         &kp K         &kp L         &kp SEMI      &mt RIGHT_SHIFT RIGHT_PARENTHESIS
&kp LCTRL        &kp Z         &kp X         &kp C         &kp V         &kp B             &kp N           &kp M         &kp COMMA     &kp DOT       &kp FSLH      &mt RCTRL ESC
                               &kp SPACE     &mo 1         &kp LALT      &mo MSK  &kp DEL  &kp LEFT_SHIFT  &mo 2         &kp ENTER
            >;
        };

        Lower {
            label = "Lower";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI |     | SPC |   | ENT |     | ALT |
            //                          | LWR |               | RSE  |

            bindings = <
&tog 3      &kp LANG4     &kp LEFT       &kp UP_ARROW  &kp DOWN_ARROW    &kp RIGHT             &kp LEFT_ARROW  &kp UP_ARROW       &kp DOWN     &kp RIGHT      &kp RIGHT_BRACE  &kp PLUS
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3      &bt BT_SEL 4          &trans          &trans             &trans       &trans         &trans           &kp PRINTSCREEN
&trans      &trans        &trans         &kp UP_ARROW  &trans            &kp LG(T)             &kp HOME        &kp END            &kp PAGE_UP  &kp PAGE_DOWN  &trans           &kp DELETE
&trans      &kp LG(A)     &kp LEFT       &kp DOWN      &kp RIGHT         &kp LG(G)             &kp GRAVE       &kp DOUBLE_QUOTES  &kp SQT      &trans         &kp SEMI         &kp SQT
&trans      &kp LG(Z)     &kp LG(X)      &kp LG(C)     &kp LG(V)         &kp LEFT_WIN          &kp CARET       &kp TILDE          &kp COMMA    &kp DOT        &kp FSLH         &kp ESC
                          &kp C_AC_BACK  &trans        &kp C_AC_FORWARD  &trans        &trans  &trans          &trans             &trans
            >;
        };

        Raise {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |
            //                          | LWR |               | RSE  |

            bindings = <
&kp TAB    &kp LEFT_BRACE  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT          &kp LEFT   &kp UP_ARROW  &kp DOWN          &kp RIGHT             &kp RPAR               &kp EQUAL
&kp LCTRL  &trans          &kp AT_SIGN     &trans        &trans          &trans             &kp MINUS  &kp EQUAL     &kp EQUAL         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&trans     &trans          &trans          &kp UP_ARROW  &trans          &trans             &kp UNDER  &kp PLUS      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp AT                 &kp TILDE
&trans     &trans          &kp LEFT        &kp DOWN      &kp RIGHT       &trans             &kp UNDER  &kp PLUS      &kp LBRC          &kp RBRC              &kp NON_US_HASH        &kp TILDE
&trans     &kp BACKSLASH   &trans          &trans        &trans          &trans             &kp UNDER  &kp PLUS      &kp LBRC          &kp RBRC              &kp NON_US_BSLH        &kp LS(NON_US_BACKSLASH)
                           &trans          &trans        &trans          &trans     &trans  &trans     &trans        &trans
            >;
        };

        Hiragana {
            label = "Hiragana";
            bindings = <
&trans     &kp LBKT  &trans  &trans  &trans  &trans          &trans  &trans  &trans     &trans   &kp RBKT  &kp EQUAL
&kp GRAVE  &kp N1    &kp N2  &kp N3  &kp N4  &kp N5          &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp APOS   &kp Q     &kp W   &kp E   &kp R   &kp T           &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSPC
&kp LSHFT  &kp A     &kp S   &kp D   &kp F   &kp G           &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp APOS
&kp LCTRL  &kp Z     &kp X   &kp C   &kp V   &kp B           &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RCTRL
                     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Game {
            label = "Game";
            bindings = <
&trans  &trans  &trans     &trans   &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans   &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans   &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans   &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans   &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
                &mkp LCLK  &mo MSC  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Game_++ {
            label = "Game ++";
            bindings = <
&trans  &trans  &trans     &trans   &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans   &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans   &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans   &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans   &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
                &mkp LCLK  &mo MSC  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Mouse {
            bindings = <
&trans  &trans  &trans     &trans   &trans     &trans               &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans   &trans     &trans               &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans   &trans     &trans               &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans   &trans     &trans               &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans   &trans     &pickup_hop          &trans  &trans  &trans  &trans  &trans  &trans
                &mkp LCLK  &mo MSC  &mkp RCLK  &trans       &trans  &trans  &trans  &trans
            >;
        };

        Scroll {
            bindings = <
&trans  &trans  &trans     &trans  &trans     &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans  &trans     &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans  &trans     &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans  &trans     &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans  &trans     &trans          &trans  &trans  &trans  &trans  &trans  &trans
                &mkp LCLK  &trans  &mkp RCLK  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
